# TEC_Q5EP Environment Variables
# Copy this to .env and fill in your actual values
# Never commit .env to git - it's in .gitignore

# ===== AI MODEL PROVIDERS =====
# OpenAI
OPENAI_API_KEY=sk-proj-...

# Azure OpenAI (TEC Agent resource)
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://tecagent.openai.azure.com/

# xAI (Grok)
XAI_API_KEY=xai-...

# GitHub Models
GITHUB_TOKEN=ghp_... or github_pat_...

# Hugging Face
HF_API_KEY=hf_...
HUGGINGFACEHUB_API_TOKEN=hf_...

# Anthropic (for LiteLLM proxy)
ANTHROPIC_API_KEY=sk-ant-api03-...

# ===== TEC SERVICES =====
# Bitwarden Secrets Manager
BW_CLIENTID=your-bitwarden-client-id
BW_CLIENTSECRET=your-bitwarden-client-secret
BW_ACCESS_TOKEN=your-secrets-manager-access-token

# Supabase (if using)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# ===== TEC Q5EP CONFIG =====
# API Configuration
API_HOST=localhost
API_PORT=8000
API_KEY=your-api-secret-key

# Database
DATABASE_URL=sqlite:///./tec_q5ep.db

# Environment
ENVIRONMENT=development
DEBUG=true

# Agent Configuration
EPISTEMIC_STANCE=skeptical
CONFIDENCE_THRESHOLD=0.7